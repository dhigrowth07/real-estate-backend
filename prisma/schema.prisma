// ==============================================================================
// Prisma Schema for Single-Tenant Real Estate Lead-Property Matching App
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  ADMIN
  AGENT
}

enum AgentVisibilityMode {
  ASSIGNED_ONLY
  ALL
}

enum LeadSource {
  WEBSITE
  REFERRAL
  DIRECT_CALL
  PORTAL
  WALK_IN
  INSTAGRAM
  WHATSAPP
  OTHER
}

enum LeadPurpose {
  BUY
  RENT
  INVESTMENT
}

enum LeadUrgency {
  IMMEDIATE
  WITHIN_1_MONTH
  WITHIN_3_MONTHS
  EXPLORING
}

enum LeadStage {
  UNQUALIFIED
  NEW
  CONTACTED
  REQUIREMENT_GATHERED
  SITE_VISIT_SCHEDULED
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  COMMERCIAL
  INDEPENDENT_HOUSE
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  WITHIN_3_MONTHS
  WITHIN_6_MONTHS
}

enum PropertyStatus {
  AVAILABLE
  UNDER_OFFER
  SOLD
  INACTIVE
}

enum MatchStatus {
  NEW
  NOTIFIED
  VIEWED
  DISMISSED
}

enum InteractionChannel {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  SMS
  NOTE
}

enum InteractionType {
  INITIAL_CONTACT
  FOLLOW_UP
  SITE_VISIT
  PROPOSAL
  FEEDBACK
  OTHER
}

enum NotificationType {
  MATCH_ALERT
  SYSTEM
}

// ------------------------------------------------------------------------------
// MODELS
// ------------------------------------------------------------------------------

/// Global Agency settings for the single-tenant business
model AgencySetting {
  id                  String              @id @default("default")
  agentVisibilityMode AgentVisibilityMode @default(ALL)
  matchingWeights     Json?               // Configurable weights for matching engine
  minAlertScore       Int                 @default(70) // Threshold score to trigger notifications
  updatedAt           DateTime            @updatedAt

  @@map("agency_settings")
}

/// Admin-generated invites for agent onboarding
model Invite {
  id          String    @id @default(uuid())
  email       String
  token       String    @unique
  role        UserRole  @default(AGENT)
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User      @relation("CreatedInvites", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@map("invites")
}

/// Represents internal real estate agency users (1 Admin + Agent team)
model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  passwordHash       String
  role               UserRole       @default(AGENT)
  leads              Lead[]         @relation("AssignedAgent")
  propertiesAssigned Property[]     @relation("AssignedPropertyAgent")
  interactions       Interaction[]
  invitesCreated     Invite[]       @relation("CreatedInvites")
  notifications      Notification[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([role])
  @@map("users")
}

/// Represents buyer / tenant / investor inquiries & criteria
model Lead {
  id                    String         @id @default(uuid())
  name                  String
  phone                 String         @default("")
  email                 String?
  source                LeadSource     @default(WEBSITE)
  sources               String[]       @default([]) // Multi-attribution tracking (e.g. WEBSITE, INSTAGRAM_COMMENT)
  budgetMin             Float          @default(0)
  budgetMax             Float          @default(0)
  preferredLocations    String[]       @default([])
  propertyType          PropertyType   @default(APARTMENT)
  bhk                   String?
  purpose               LeadPurpose    @default(BUY)
  urgency               LeadUrgency    @default(IMMEDIATE)
  stage                 LeadStage      @default(NEW)
  assignedAgentId       String?
  assignedAgent         User?          @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  instagramUserId       String?        @unique // Instagram Scoped User ID (IGSID) for DMs/Comments attribution
  whatsappOptIn         Boolean        @default(false) // Verified WhatsApp opt-in consent status
  whatsappOptInEvidence String?        // Message / timestamp text establishing consent
  interestedPropertyId  String?        // Specific property user showed interest in
  interestedProperty    Property?      @relation("InterestedLeads", fields: [interestedPropertyId], references: [id], onDelete: SetNull)
  matches               Match[]
  interactions          Interaction[]
  conversations         Conversation[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?      // Soft delete timestamp

  @@index([stage])
  @@index([source])
  @@index([urgency])
  @@index([propertyType])
  @@index([assignedAgentId])
  @@index([instagramUserId])
  @@index([interestedPropertyId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("leads")
}

/// Represents real estate inventory and property specifications
model Property {
  id               String                @id @default(uuid())
  title            String
  location         String
  price            Float
  propertyType     PropertyType          @default(APARTMENT)
  bhk              String?
  sqft             Float?
  possessionStatus PossessionStatus      @default(READY_TO_MOVE)
  amenities        String[]
  ownerContact     String
  images           String[]
  status           PropertyStatus        @default(AVAILABLE)
  assignedAgentId  String?
  assignedAgent    User?                 @relation("AssignedPropertyAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  matches          Match[]
  interestedLeads  Lead[]                @relation("InterestedLeads")
  postMappings     PostPropertyMapping[]
  pendingInterests PendingInterest[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?             // Soft delete timestamp

  @@index([status])
  @@index([propertyType])
  @@index([possessionStatus])
  @@index([price])
  @@index([bhk])
  @@index([assignedAgentId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("properties")
}

/// Stores bi-directional compatibility scoring generated by the matching engine
model Match {
  id            String         @id @default(uuid())
  leadId        String
  lead          Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  score         Float          // Compatibility score 0 - 100
  status        MatchStatus    @default(NEW)
  breakdown     Json?          // Sub-score breakdown (budget, location, type, bhk, possession)
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([leadId, propertyId])
  @@index([leadId])
  @@index([propertyId])
  @@index([status])
  @@index([score])
  @@map("matches")
}

/// Real-time alerts and notifications for high-scoring matches and system events
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId   String?
  match     Match?           @relation(fields: [matchId], references: [id], onDelete: Cascade)
  type      NotificationType @default(MATCH_ALERT)
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

/// Logs communications and touchpoints between agents and leads
model Interaction {
  id        String             @id @default(uuid())
  leadId    String
  lead      Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channel   InteractionChannel @default(CALL)
  type      InteractionType    @default(FOLLOW_UP)
  notes     String
  timestamp DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([leadId])
  @@index([agentId])
  @@index([timestamp])
  @@map("interactions")
}

// ------------------------------------------------------------------------------
// PHASE 2: CONVERSATION & MESSAGING MODELS
// ------------------------------------------------------------------------------

enum ChannelType {
  WHATSAPP
  INSTAGRAM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  TEMPLATE
  AUTO_REPLY
}

enum MessageStatus {
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

/// Tracks two-way chat sessions across WhatsApp and Instagram
model Conversation {
  id              String       @id @default(uuid())
  leadId          String?
  lead            Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  channel         ChannelType  // WHATSAPP or INSTAGRAM
  externalId      String       // Phone number for WhatsApp or IGSID for Instagram
  windowOpenUntil DateTime?    // 24-hour Meta messaging customer care session window
  messages        Message[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([channel, externalId])
  @@index([leadId])
  @@index([channel])
  @@index([externalId])
  @@index([windowOpenUntil])
  @@map("conversations")
}

/// Stores individual chat messages with deduplication & delivery tracking
model Message {
  id                String           @id @default(uuid())
  conversationId    String
  conversation      Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessageDirection // INBOUND or OUTBOUND
  rawText           String           // Raw text content of the message
  messageType       MessageType      @default(TEXT) // TEXT, TEMPLATE, AUTO_REPLY
  externalMessageId String?          @unique // Meta message ID (wamid / mid) for deduplication
  status            MessageStatus    @default(RECEIVED) // RECEIVED, SENT, DELIVERED, READ, FAILED
  createdAt         DateTime         @default(now())

  @@index([conversationId])
  @@index([direction])
  @@index([status])
  @@index([createdAt])
  @@map("messages")
}

/// Maps an Instagram Post, Reel, or Ad to a specific real estate property in the catalog
model PostPropertyMapping {
  id               String   @id @default(uuid())
  instagramMediaId String   @unique // Meta Instagram Media ID (post or reel)
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([instagramMediaId])
  @@index([propertyId])
  @@map("post_property_mappings")
}

/// Short-lived record linking an Instagram comment inquiry to a subsequent DM interaction
model PendingInterest {
  id                String   @id @default(uuid())
  commentId         String?  @unique // Meta Comment ID for exact event deduplication
  instagramUserId   String   // IGSID of the user who commented
  commenterUsername String?  // Public Instagram handle of commenter if available
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  commentText       String   // Content of the user's comment
  commentedAt       DateTime @default(now())
  resolved          Boolean  @default(false) // True once answered/converted in DM
  createdAt         DateTime @default(now())

  @@index([commentId])
  @@index([instagramUserId])
  @@index([propertyId])
  @@index([resolved])
  @@map("pending_interests")
}

// ------------------------------------------------------------------------------
// WEBHOOK MODELS & ENUMS
// ------------------------------------------------------------------------------

enum WebhookPlatform {
  WHATSAPP
  INSTAGRAM
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

/// Stores raw incoming webhook payloads for auditing, replay, and zero data loss
model WebhookLog {
  id          String          @id @default(uuid())
  platform    WebhookPlatform
  eventType   String?         // e.g. "messages", "comments", "statuses", "messaging_postbacks"
  rawPayload  Json            // Unaltered raw payload from Meta
  headers     Json?           // Request headers (including X-Hub-Signature-256)
  status      WebhookStatus   @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([platform])
  @@index([eventType])
  @@index([status])
  @@index([createdAt])
  @@map("webhook_logs")
}


