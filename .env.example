# ==============================================================================
# Real Estate CRM Backend - Environment Variables
# ==============================================================================

# Application Port (runs standalone on port 3001)
PORT=3001
NODE_ENV=development

# CORS Configuration
# Base URL of the separate frontend repo (running standalone on port 3000)
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Connection (Prisma)
# Replace with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_crm?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_single_tenant_dev_change_in_prod
JWT_EXPIRES_IN=7d
